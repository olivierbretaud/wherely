# Identité de marque : copier en brand.env (cp brand.env.example brand.env).
# Public et sans secret : ces valeurs sont visibles dans le front.
# Les secrets restent dans .env (voir .env.example).
#
# PROVISOIRE : le nom du produit n'est pas choisi (ADR-25 : Wherely, Wheretale
# ou Wherizon). Les valeurs ci-dessous reprennent le nom actuel et des adresses
# locales ; aucun domaine n'est acheté. À remplacer une fois le nom tranché.

# --- Backend (Spring), Ansible, Caddy ---

# Nom affiché (provisoire)
BRAND_NAME=Wherely
# Identifiant technique : minuscules, sans espace (provisoire)
BRAND_SLUG=wherely
# Slogans (provisoires, à décider)
BRAND_TAGLINE_FR="Votre voyage, sur la carte."
BRAND_TAGLINE_EN="Your journey, mapped."
# Domaines (provisoires : développement local, aucun domaine réservé)
BRAND_DOMAIN=localhost
BRAND_APP_URL=http://localhost:5173
BRAND_API_URL=http://localhost:8080
BRAND_MAIL_DOMAIN=localhost
# Adresses (provisoires : domaine local)
BRAND_SUPPORT_EMAIL=contact@localhost
BRAND_MAIL_FROM=no-reply@localhost

# --- Front (Vite, lu au build) : reprend les valeurs ci-dessus ---

VITE_BRAND_NAME=${BRAND_NAME}
VITE_BRAND_SLUG=${BRAND_SLUG}
VITE_BRAND_TAGLINE_FR=${BRAND_TAGLINE_FR}
VITE_BRAND_TAGLINE_EN=${BRAND_TAGLINE_EN}
VITE_BRAND_APP_URL=${BRAND_APP_URL}
VITE_BRAND_API_URL=${BRAND_API_URL}
VITE_BRAND_SUPPORT_EMAIL=${BRAND_SUPPORT_EMAIL}
