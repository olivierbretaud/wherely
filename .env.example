# Modèle de configuration locale : copier en .env et renseigner les valeurs.
# Ne jamais versionner de valeur réelle dans ce fichier.

# Base de données (PostgreSQL)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# Authentification
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=

# Stockage des médias (Cloudinary)
CLOUDINARY_URL=

# E-mails (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Cartographie (ArcGIS / Esri)
VITE_ARCGIS_API_KEY=

# Supervision (Sentry)
SENTRY_DSN=
VITE_SENTRY_DSN=

# URL
VITE_API_URL=
APP_URL=
